    "/saleshub/todo/complete": {
        "method": "POST",
        "summary": "待办完成状态变更",
        "description": "变更待办事项的完成状态，是否完成是整条待办的总体状态（不按执行人拆分），任意执行人或管理员均可操作。仅正常状态（status=1）待办可操作，不存在或已删除时 result=1、msg 为「待办事项不存在或已删除」。标记完成（is_completed=2）时写入完成时间 completed_time；取消完成（is_completed=1）时清空完成时间。传入与当前相同的状态视为幂等操作，直接返回成功。参数校验失败时 result=1，msg 为具体校验提示；操作失败时 result=1、msg 为「操作失败」。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "todo_id": {
                    "type": "string",
                    "description": "待办事项主键 UUID（无连字符，32 位）"
                },
                "is_completed": {
                    "type": "number",
                    "enum": [
                        1,
                        2
                    ],
                    "description": "是否完成：1-否，2-是"
                }
            },
            "required": [
                "todo_id",
                "is_completed"
            ]
        },
        "example_request": {
            "todo_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e7c",
            "is_completed": 2
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-参数校验失败、待办不存在或操作失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「待办事项不存在或已删除」「操作失败」"
                }
            }
        }
    },
    "/saleshub/todo/postpone": {
        "method": "POST",
        "summary": "待办延期",
        "description": "待办事项延期，处理人和管理员均可操作，需填写延期后截止日期与延期原因。仅正常状态（status=1）待办可操作。新截止日期必须晚于当前截止日期，否则 result=1、msg 为「延期后截止日期必须晚于当前截止日期」。事务内更新 todo.deadline 的同时插入一条延期记录（记录只增不改），本次延期天数 delay_days 由服务端按 新截止日期-当前截止日期 计算。行级锁（pessimistic_write）防止并发延期。参数校验失败时 result=1，msg 为具体校验提示（如「延期原因不能为空」「延期后截止日期格式必须为YYYY-MM-DD」）。事务写入失败时 result=1、msg 为「操作失败」。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "todo_id": {
                    "type": "string",
                    "description": "待办事项主键 UUID（无连字符，32 位）"
                },
                "new_deadline": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "延期后截止日期，格式 YYYY-MM-DD，必须晚于当前截止日期"
                },
                "reason": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200,
                    "description": "延期原因，2~200 字符"
                },
                "operator_id": {
                    "type": "string",
                    "description": "延期操作人用户 ID（处理人或管理员）"
                }
            },
            "required": [
                "todo_id",
                "new_deadline",
                "reason",
                "operator_id"
            ]
        },
        "example_request": {
            "todo_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e7c",
            "new_deadline": "2026-12-10",
            "reason": "C 区仓库盘点设备未到位，需顺延",
            "operator_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-参数校验失败、待办不存在、新日期不晚于当前截止日期或事务写入失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「待办事项不存在或已删除」「延期后截止日期必须晚于当前截止日期」「操作失败」"
                }
            }
        }
    },
    "/saleshub/todo/delete": {
        "method": "POST",
        "summary": "删除待办事项",
        "description": "软删除待办事项：主表 status 置为 2（删除），删除后不再出现在列表/详情中。仅正常状态（status=1）待办可删除，不存在或已删除时 result=1、msg 为「待办事项不存在或已删除」。参数校验失败时 result=1，msg 为具体校验提示；删除失败时 result=1、msg 为「删除失败」。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "todo_id": {
                    "type": "string",
                    "description": "待办事项主键 UUID（无连字符，32 位）"
                }
            },
            "required": [
                "todo_id"
            ]
        },
        "example_request": {
            "todo_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e7c"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-参数校验失败、待办不存在或删除失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「待办事项不存在或已删除」「删除失败」"
                }
            }
        }
    }
