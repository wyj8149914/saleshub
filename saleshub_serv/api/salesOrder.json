                        },
                        "customer_name": {
                            "type": "string",
                            "description": "客户名称"
                        },
                        "customer_phone": {
                            "type": "string",
                            "description": "客户联系方式"
                        },
                        "address": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "收货地址，可能为 null"
                        },
                        "amount": {
                            "type": "string",
                            "description": "订单金额，数字字符串（如 12800.00）"
