    "/saleshub/order/receive": {
        "method": "POST",
        "summary": "销售订单收款",
        "description": "销售订单收款登记：传入本次收款金额，服务端累加到订单已收金额。校验顺序：订单不存在或已停用（status!=1）时 result=1、msg 为「销售订单不存在或已停用」；订单已取消（order_status=4）时不可收款，msg 为「已取消订单不可收款」；本次收款金额累加后超过订单金额时整单拒绝，msg 为「收款金额超过订单未收金额」。校验通过后累加已收金额并按已收/订单金额自动推导收款状态落库（0-未收→1-未收款，部分→2-部分收款，足额→3-已收款，以分为单位比较避免浮点误差）。成功返回更新后的已收金额与收款状态。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "order_id": {
                    "type": "string",
                    "description": "销售订单主键 UUID（无连字符，32 位）"
                },
                "received_amount": {
                    "type": "number",
                    "minimum": 0.01,
                    "description": "本次收款金额，最多两位小数，必须大于 0"
                }
            },
            "required": [
                "order_id",
                "received_amount"
            ]
        },
        "example_request": {
            "order_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e1c",
            "received_amount": 5000.00
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-订单不存在/已停用/已取消、收款超额、参数校验失败或操作失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「销售订单不存在或已停用」「已取消订单不可收款」「收款金额超过订单未收金额」「收款金额必须大于0」「操作失败」"
                },
                "datas": {
                    "type": "object",
                    "description": "收款结果。失败时无此字段",
                    "properties": {
                        "received_amount": {
                            "type": "string",
                            "description": "累加后的已收金额，数字字符串（如 5000.00）"
                        },
                        "pay_status": {
                            "type": "number",
                            "description": "更新后的收款状态：1-未收款，2-部分收款，3-已收款"
                        }
                    }
                }
            }
        }
    },
    "/saleshub/order/updateStatus": {
        "method": "POST",
        "summary": "销售订单状态变更",
        "description": "变更销售订单的交货状态。仅正常状态（status=1）订单可操作，不存在或已停用时 result=1、msg 为「销售订单不存在或已停用」。已取消（order_status=4）为终态，不可再变更，msg 为「已取消订单为终态,不可变更状态」；其余状态（1-待交货，2-已交货，3-已完成）可自由设置。传入与当前相同的状态视为幂等操作，直接返回成功。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "order_id": {
                    "type": "string",
                    "description": "销售订单主键 UUID（无连字符，32 位）"
                },
                "order_status": {
                    "type": "number",
                    "enum": [
                        1,
                        2,
                        3,
                        4
                    ],
                    "description": "目标订单状态：1-待交货，2-已交货，3-已完成，4-已取消"
                }
            },
            "required": [
                "order_id",
                "order_status"
            ]
        },
        "example_request": {
            "order_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e1c",
            "order_status": 2
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功（含同状态幂等成功），1-订单不存在/已停用/已取消、参数校验失败或操作失败"
                },
                "msg": {
