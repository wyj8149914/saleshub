{
    "/saleshub/inventory/stockIn": {
        "method": "POST",
        "summary": "入库",
        "description": "对指定零件的指定规格进行入库操作。事务执行：① 校验零件存在（inventory_item.status=1）；② 校验规格存在（inventory_item_spec 中 item_id+spec_id 匹配且 status=1）；③ 写入入库记录（record_id 为 UUID v7 去连字符，record_no 格式 SI + 6 位递增数字如 SI000001，上限 999999），同时记录 before_stock（入库前库存）与 after_stock（入库后库存）；④ 将该规格库存 inventory_item_spec.current_stock 增加 quantity。photo_id 关联 public.minio_file.relation_id（须先通过文件上传接口获取）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "item_id": {
                    "type": "string",
                    "description": "零件主键 UUID（无连字符，32 位）"
                },
                "spec_id": {
                    "type": "string",
                    "description": "入库规格 ID（inventory_item_spec.spec_id，来自零件列表接口 specs[].spec_id）"
                },
                "quantity": {
                    "type": "number",
                    "description": "入库数量，正整数（最小 1）"
                },
                "date": {
                    "type": "string",
                    "description": "入库日期，格式 YYYY-MM-DD（如 2026-06-24）"
                },
                "photo_id": {
                    "type": "string",
                    "description": "入库照片 ID（必填，关联 file.relation_id，最长 32 字符）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符）"
                }
            },
            "required": [
                "item_id",
                "spec_id",
                "quantity",
                "date",
                "photo_id"
            ]
        },
        "example_request": {
            "item_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "spec_id": "0194b1d0e3f45a6b7890123456789def",
            "quantity": 100,
            "date": "2026-06-24",
            "photo_id": "0194b1c0a2d34e5f6789012345678aab",
            "remark": "供应商A批次到货"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-零件不存在/零件不存在规格/入库失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「入库成功」「零件不存在」「零件不存在规格」「入库失败」"
                }
            }
        }
    },
    "/saleshub/inventory/stockInBatch": {
        "method": "POST",
        "summary": "按零件批量入库",
        "description": "一次性入库多条零件+规格明细，同一批次内所有入库记录共用同一个 record_no。事务内原子执行：① 校验列表中 (item_id, spec_id) 组合无重复；② 校验所有零件存在（inventory_item.status=1）；③ 校验所有规格存在且属于对应零件（inventory_item_spec.status=1）；④ 全部通过后写入多条 stock_in_record（共用 record_no，每条记录含 before_stock/after_stock），并增加对应规格库存 inventory_item_spec.current_stock，任一环节失败整体回滚。photo_id 为本批次共用入库照片，关联 public.minio_file.relation_id（须先通过文件上传接口获取）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "description": "入库明细列表（至少一条，item_id+spec_id 不可重复）",
                    "items": {
                        "type": "object",
                        "properties": {
                            "item_id": {
                                "type": "string",
                                "description": "零件主键 UUID（无连字符，32 位）"
                            },
                            "spec_id": {
                                "type": "string",
                                "description": "入库规格 ID（inventory_item_spec.spec_id，来自零件列表接口 specs[].spec_id）"
                            },
                            "quantity": {
                                "type": "number",
                                "description": "入库数量，正整数（最小 1）"
                            }
                        },
                        "required": [
                            "item_id",
                            "spec_id",
                            "quantity"
                        ]
                    }
                },
                "date": {
                    "type": "string",
                    "description": "入库日期，格式 YYYY-MM-DD（如 2026-06-24）"
                },
                "photo_id": {
                    "type": "string",
                    "description": "入库照片 ID（必填，本批次所有记录共用，关联 file.relation_id，最长 32 字符）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符，本批次所有记录共用）"
                }
            },
            "required": [
                "items",
                "date",
                "photo_id"
            ]
        },
        "example_request": {
            "items": [
                {
                    "item_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
                    "spec_id": "0194b1d0e3f45a6b7890123456789def",
                    "quantity": 100
                },
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abd",
                    "spec_id": "0194b1d0e3f45a6b7890123456789deh",
                    "quantity": 50
                }
            ],
            "date": "2026-06-24",
            "photo_id": "0194b1c0a2d34e5f6789012345678aab",
            "remark": "供应商A批次到货"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-入库列表存在重复/零件不存在或已停用/零件不存在规格/入库失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息；重复时返回「入库列表存在重复的(零件+规格)」；零件缺失时返回「零件不存在或已停用: <id列表>」；规格缺失时返回「零件 <item_id> 不存在规格 <spec_id>」"
                }
            }
        }
    },
    "/saleshub/inventory/stockOut": {
        "method": "POST",
        "summary": "出库（单条）",
        "description": "对指定零件的指定规格进行单条出库操作。事务执行：① 校验零件存在（inventory_item.status=1）；② 校验规格存在（inventory_item_spec 中 item_id+spec_id 匹配且 status=1）；③ 校验该规格库存充足（current_stock >= quantity）；④ 写入出库记录（record_id 为 UUID v7 去连字符，record_no 格式 SO + 6 位递增数字如 SO000001，上限 999999），同时记录 before_stock（出库前库存）与 after_stock（出库后库存）；⑤ 将该规格库存减少 quantity。本接口每次调用生成独立 record_no。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "item_id": {
                    "type": "string",
                    "description": "零件主键 UUID"
                },
                "spec_id": {
                    "type": "string",
                    "description": "出库规格 ID（inventory_item_spec.spec_id）"
                },
                "quantity": {
                    "type": "number",
                    "description": "出库数量，正整数（最小 1）"
                },
                "date": {
                    "type": "string",
                    "description": "出库日期，格式 YYYY-MM-DD"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符）"
                }
            },
            "required": [
                "item_id",
                "spec_id",
                "quantity",
                "date"
            ]
        },
        "example_request": {
            "item_id": "0194b1c0a2d34e5f6789012345678abc",
            "spec_id": "0194b1d0e3f45a6b7890123456789def",
            "quantity": 5,
            "date": "2026-06-24",
            "remark": "产线领料"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-零件不存在/零件不存在规格/库存不足/出库失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息；库存不足时返回「规格 <spec_id> 库存不足(当前 N,需要 M)」"
                }
            }
        }
    },
    "/saleshub/inventory/stockOutBatch": {
        "method": "POST",
        "summary": "按零件批量出库",
        "description": "一次性出库多条零件+规格明细，同一批次内所有出库记录共用同一个 record_no。事务内原子执行：① 校验列表中 (item_id, spec_id) 组合无重复；② 校验所有零件存在（status=1）；③ 校验所有规格存在且属于对应零件（status=1）；④ 校验每条明细库存充足；⑤ 全部通过后写入多条 stock_out_record（共用 record_no，每条记录含 before_stock/after_stock）并扣减对应规格库存，任一环节失败整体回滚。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "description": "出库明细列表（至少一条，item_id+spec_id 不可重复）",
                    "items": {
                        "type": "object",
                        "properties": {
                            "item_id": {
                                "type": "string",
                                "description": "零件主键 UUID"
                            },
                            "spec_id": {
                                "type": "string",
                                "description": "出库规格 ID（inventory_item_spec.spec_id）"
                            },
                            "quantity": {
                                "type": "number",
                                "description": "出库数量，正整数（最小 1）"
                            }
                        },
                        "required": [
                            "item_id",
                            "spec_id",
                            "quantity"
                        ]
                    }
                },
                "date": {
                    "type": "string",
                    "description": "出库日期，格式 YYYY-MM-DD"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符，本批次所有记录共用）"
                }
            },
            "required": [
                "items",
                "date"
            ]
        },
        "example_request": {
            "items": [
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abc",
                    "spec_id": "0194b1d0e3f45a6b7890123456789def",
                    "quantity": 2
                },
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abd",
                    "spec_id": "0194b1d0e3f45a6b7890123456789deh",
                    "quantity": 1
                }
            ],
            "date": "2026-06-24",
            "remark": "产线批量领料"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-出库列表存在重复/零件不存在或已停用/零件不存在规格/库存不足/出库失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息；重复时返回「出库列表存在重复的(零件+规格)」；零件缺失时返回「零件不存在或已停用: <id列表>」"
                }
            }
        }
    },
    "/saleshub/inventory/stockOutByProduct": {
        "method": "POST",
        "summary": "按产品出库",
        "description": "按产品 BOM 自动计算并批量出库，同一批次所有出库记录共用同一个 record_no。事务执行：① 校验产品存在（product.status=1）；② 读取该产品有效 BOM（product_item.status=1）；③ 若 BOM 为空返回「产品未配置零件」；④ 按 BOM 生成出库明细，每条出库数量 = 入参 quantity（产品台数）× quantity_per_product；⑤ 执行与批量出库相同的校验与扣减逻辑，每条记录写入 before_stock/after_stock。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID"
                },
                "quantity": {
                    "type": "number",
                    "description": "出库产品台数，正整数（最小 1）"
                },
                "date": {
                    "type": "string",
                    "description": "出库日期，格式 YYYY-MM-DD"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符，本批次所有记录共用）"
                }
            },
            "required": [
                "product_id",
                "quantity",
                "date"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "quantity": 10,
            "date": "2026-06-24",
            "remark": "成品组装出库"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-产品不存在/产品未配置零件/库存不足/出库失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「出库成功」「产品不存在」「产品未配置零件」及库存不足等校验信息"
                }
            }
        }
    },
    "/saleshub/inventory/stockInList": {
        "method": "GET",
        "summary": "入库记录列表",
        "description": "分页查询当前正常状态（status=1）的入库记录。支持按入库日期区间 start_date/end_date（格式 YYYY-MM-DD，含起止日）、零件 item_id、规格 spec_id、记录编号 record_no（精确匹配，批量入库时同一 record_no 对应多条明细）筛选。LEFT JOIN inventory_item（status=1）取零件名称 item_name，LEFT JOIN inventory_item_spec（status=1）取规格文本 spec（空串为默认 SKU），LEFT JOIN public.minio_file 取入库照片 MinIO 对象键 object_name（通过 photo_id = relation_id 关联）。按 create_time 降序。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "pageIndex": {
                    "type": "number",
                    "description": "页码，从 1 开始（Query 参数）"
                },
                "pageSize": {
                    "type": "number",
                    "description": "每页条数（Query 参数）"
                },
                "start_date": {
                    "type": "string",
                    "description": "开始日期，格式 YYYY-MM-DD（Query 参数，可选，筛选 rec.date >= start_date）"
                },
                "end_date": {
                    "type": "string",
                    "description": "结束日期，格式 YYYY-MM-DD（Query 参数，可选，筛选 rec.date <= end_date，含当日）"
                },
                "item_id": {
                    "type": "string",
                    "description": "零件主键 UUID（Query 参数，可选，精确匹配，最长 32 字符）"
                },
                "spec_id": {
                    "type": "string",
                    "description": "规格 ID（Query 参数，可选，精确匹配 inventory_item_spec.spec_id，最长 32 字符）"
                },
                "record_no": {
                    "type": "string",
                    "description": "入库记录编号（Query 参数，可选，精确匹配，格式 SI + 6 位数字如 SI000001，最长 50 字符）"
                }
            },
            "required": [
                "pageIndex",
                "pageSize"
            ]
        },
        "example_request": {
            "pageIndex": 1,
            "pageSize": 10,
            "start_date": "2026-06-01",
            "end_date": "2026-06-30",
            "record_no": "SI000001"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，成功时为 success"
                },
                "datas": {
                    "type": "object",
                    "description": "分页结果",
                    "properties": {
                        "total": {
                            "type": "number",
                            "description": "符合条件的总条数"
                        },
                        "items": {
                            "type": "array",
                            "description": "入库记录列表",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "record_id": {
                                        "type": "string",
                                        "description": "记录主键 UUID（无连字符，32 位）"
                                    },
                                    "record_no": {
                                        "type": "string",
                                        "description": "入库记录编号，格式 SI + 6 位递增数字（如 SI000001）；批量入库时多条明细共用同一编号"
                                    },
                                    "date": {
                                        "type": "string",
                                        "description": "入库日期，格式 YYYY-MM-DD"
                                    },
                                    "quantity": {
                                        "type": "number",
                                        "description": "入库数量"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    },
                                    "photo_id": {
                                        "type": "string",
                                        "description": "入库照片 ID（关联 public.minio_file.relation_id），可能为 null"
                                    },
                                    "object_name": {
                                        "type": "string",
                                        "description": "入库照片 MinIO 对象键（LEFT JOIN minio_file 取得），无照片或未关联时为 null；公开访问 URL 拼接规则与文件上传接口返回的 url 相同（MINIO_URL/bucket/object_name）"
                                    },
                                    "before_stock": {
                                        "type": "number",
                                        "description": "入库前该规格库存数量"
                                    },
                                    "after_stock": {
                                        "type": "number",
                                        "description": "入库后该规格库存数量"
                                    },
                                    "item_name": {
                                        "type": "string",
                                        "description": "零件名称（关联 inventory_item.name），零件已删除或未关联时为 null"
                                    },
                                    "spec": {
                                        "type": "string",
                                        "description": "规格文本（关联 inventory_item_spec.spec），空串为默认 SKU；规格已删除或未关联时为 null"
                                    },
                                    "create_time": {
                                        "type": "string",
                                        "description": "记录创建时间，格式 YYYY-MM-DD HH:mm:ss"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "/saleshub/inventory/stockOutList": {
        "method": "GET",
        "summary": "出库记录列表",
        "description": "分页查询当前正常状态（status=1）的出库记录。支持按出库日期区间 start_date/end_date（格式 YYYY-MM-DD，含起止日）、零件 item_id、规格 spec_id、记录编号 record_no（精确匹配，批量出库或按产品出库时同一 record_no 对应多条明细）筛选。LEFT JOIN inventory_item（status=1）取零件名称 item_name，LEFT JOIN inventory_item_spec（status=1）取规格文本 spec（空串为默认 SKU）。按 create_time 降序。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "pageIndex": {
                    "type": "number",
                    "description": "页码，从 1 开始（Query 参数）"
                },
                "pageSize": {
                    "type": "number",
                    "description": "每页条数（Query 参数）"
                },
                "start_date": {
                    "type": "string",
                    "description": "开始日期，格式 YYYY-MM-DD（Query 参数，可选，筛选 rec.date >= start_date）"
                },
                "end_date": {
                    "type": "string",
                    "description": "结束日期，格式 YYYY-MM-DD（Query 参数，可选，筛选 rec.date <= end_date，含当日）"
                },
                "item_id": {
                    "type": "string",
                    "description": "零件主键 UUID（Query 参数，可选，精确匹配，最长 32 字符）"
                },
                "spec_id": {
                    "type": "string",
                    "description": "规格 ID（Query 参数，可选，精确匹配 inventory_item_spec.spec_id，最长 32 字符）"
                },
                "record_no": {
                    "type": "string",
                    "description": "出库记录编号（Query 参数，可选，精确匹配，格式 SO + 6 位数字如 SO000001，最长 50 字符）"
                }
            },
            "required": [
                "pageIndex",
                "pageSize"
            ]
        },
        "example_request": {
            "pageIndex": 1,
            "pageSize": 10,
            "start_date": "2026-06-01",
            "end_date": "2026-06-30",
            "item_id": "0194b1c0a2d34e5f6789012345678abc"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，成功时为 success"
                },
                "datas": {
                    "type": "object",
                    "description": "分页结果",
                    "properties": {
                        "total": {
                            "type": "number",
                            "description": "符合条件的总条数"
                        },
                        "items": {
                            "type": "array",
                            "description": "出库记录列表",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "record_id": {
                                        "type": "string",
                                        "description": "记录主键 UUID（无连字符，32 位）"
                                    },
                                    "record_no": {
                                        "type": "string",
                                        "description": "出库记录编号，格式 SO + 6 位递增数字（如 SO000001）；批量出库或按产品出库时多条明细共用同一编号"
                                    },
                                    "date": {
                                        "type": "string",
                                        "description": "出库日期，格式 YYYY-MM-DD"
                                    },
                                    "quantity": {
                                        "type": "number",
                                        "description": "出库数量"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    },
                                    "before_stock": {
                                        "type": "number",
                                        "description": "出库前该规格库存数量"
                                    },
                                    "after_stock": {
                                        "type": "number",
                                        "description": "出库后该规格库存数量"
                                    },
                                    "item_name": {
                                        "type": "string",
                                        "description": "零件名称（关联 inventory_item.name），零件已删除或未关联时为 null"
                                    },
                                    "spec": {
                                        "type": "string",
                                        "description": "规格文本（关联 inventory_item_spec.spec），空串为默认 SKU；规格已删除或未关联时为 null"
                                    },
                                    "create_time": {
                                        "type": "string",
                                        "description": "记录创建时间，格式 YYYY-MM-DD HH:mm:ss"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}