    "/saleshub/invoice/taxFile": {
        "method": "POST",
        "summary": "批量报税/取消报税",
        "description": "列表多选发票后批量设置报税状态。先校验后更新：任一发票不符合条件（不存在/已作废，或已处于目标报税状态）时整批拒绝，不做任何更新，result=1，msg 为「以下发票不符合报税(或取消报税)条件(不存在/已作废或状态已符合):…」并列出不合规发票 ID（最多展示 5 个，超出以「等N条」提示）。报税（is_tax_filed=2）只允许操作未报税发票，成功后写入报税时间与操作人；取消报税（is_tax_filed=1）只允许操作已报税发票，同时清空报税时间与操作人。单次最多 200 条。校验与更新之间状态被并发修改时，更新条件兜底过滤，updated_count 为实际变更条数。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "invoice_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "description": "发票主键 UUID 列表（无连字符，32 位），1~200 个",
                    "items": {
                        "type": "string"
                    }
                },
                "is_tax_filed": {
                    "type": "number",
                    "enum": [
                        1,
                        2
                    ],
                    "description": "目标报税状态：1-未报税（取消报税），2-已报税"
                },
                "user_id": {
                    "type": "string",
                    "description": "操作人用户 ID"
                }
            },
            "required": [
                "invoice_ids",
                "is_tax_filed",
                "user_id"
            ]
        },
        "example_request": {
            "invoice_ids": [
                "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
                "0194a8f0e1b27c4a9d0e8f7b6c5d4e2a"
            ],
            "is_tax_filed": 2,
            "user_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-存在不符合条件的发票、参数校验失败或操作失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「以下发票不符合报税条件(不存在/已作废或状态已符合):xxx,yyy」「发票ID列表不能为空」「单次最多操作200张发票」「报税状态只能为1-未报税或2-已报税」「操作人用户ID不能为空」「操作失败」"
                },
                "datas": {
                    "type": "object",
                    "description": "更新结果。校验被拒绝或操作失败时无此字段",
                    "properties": {
                        "updated_count": {
                            "type": "number",
                            "description": "实际发生状态变更的发票条数"
                        }
                    }
                }
            }
        }
    }
}
