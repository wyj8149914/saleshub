                                        "description": "状态：1-正常"
                                    },
                                    "create_time": {
                                        "type": "string",
                                        "description": "创建时间，YYYY-MM-DD HH24:MI:SS 格式字符串"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "/saleshub/expense/detail": {
        "method": "GET",
        "summary": "支出费用单详情",
        "description": "按 expense_id 查询单个支出费用单的完整信息。仅 status=1 的费用单可查，不存在或已作废时 result=1、msg 为「支出费用单不存在」。返回费用单全部业务字段、正常状态（status=1）采购明细行 items（按创建时间升序），以及关联发票摘要（发票号码、详细类型描述、开票日期、原始发票文件预览地址 invoice_url，通过发票 file_id 关联 minio_file 生成，文件缺失时无 invoice_url 字段）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "expense_id": {
                    "type": "string",
                    "description": "支出费用单主键 UUID（Query 参数）"
                }
            },
            "required": [
                "expense_id"
            ]
        },
        "example_request": {
            "expense_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e1b"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-费用单不存在或查询失败"
                },
                "msg": {
                    "type": "string",
