    "/saleshub/expense/bindInvoice": {
        "method": "POST",
        "summary": "支出费用单关联发票",
        "description": "供前端上传发票后回填：先调已有 /saleshub/invoice/upload 识别入库，拿到 invoice_id 后调本接口绑定到费用单。仅类型1-有发票采购费用单可关联（其他类型 result=1、msg 为「仅类型1-有发票采购费用单可关联发票」）；费用单不存在或已作废时 result=1。发票必须存在且正常状态，发票与费用单 1:1：已被其他费用单关联时拒绝，msg 为「该发票已被支出费用单关联,费用单编号:xxx」；重复关联同一发票幂等返回成功。已关联旧发票的费用单可直接换绑，旧发票自动释放。校验通过后回填发票 ID，数据库唯一约束兜底并发。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "expense_id": {
                    "type": "string",
                    "description": "支出费用单主键 UUID（无连字符，32 位）"
                },
                "invoice_id": {
                    "type": "string",
                    "description": "关联发票 ID（/saleshub/invoice/upload 返回的发票主键）"
                }
            },
            "required": [
                "expense_id",
                "invoice_id"
            ]
        },
        "example_request": {
            "expense_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e1b",
            "invoice_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e2a"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功（含重复关联同一发票的幂等成功），1-费用单不存在/类型不符、发票不存在/已被关联或操作失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「支出费用单不存在或已作废」「仅类型1-有发票采购费用单可关联发票」「发票不存在或已作废」「该发票已被支出费用单关联,费用单编号:xxx」「操作失败」"
                }
            }
        }
    },
    "/saleshub/expense/delete": {
        "method": "POST",
        "summary": "删除支出费用单",
        "description": "软删除单个支出费用单：将费用单状态置为作废（status=2），同事务内将其全部正常状态（status=1）的采购明细行置为停用（status=2），作废后不再出现在列表/详情等查询中，不做物理删除。费用单作废后，类型1关联的发票自动释放（发票本身不做任何变更），可再次被其他费用单选择或绑定。仅正常状态费用单可删除，不存在或已作废时 result=1、msg 为「支出费用单不存在或已作废」。事务写入失败时 result=1、msg 为「删除失败」。删除成功返回 result=0，无 datas 字段。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "expense_id": {
                    "type": "string",
                    "description": "支出费用单主键 UUID（无连字符，32 位）"
                }
            },
            "required": [
                "expense_id"
            ]
        },
        "example_request": {
            "expense_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e1b"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-删除成功，1-费用单不存在/已作废或删除失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息，如「success」「支出费用单不存在或已作废」「删除失败」"
                }
            }
        }
    }
}