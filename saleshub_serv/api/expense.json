                                        "type": "number",
                                        "description": "费用类型：1-有发票采购，2-无发票支出"
                                    },
                                    "user_id": {
                                        "type": "string",
                                        "description": "创建人用户 ID"
                                    },
                                    "invoice_id": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "description": "关联发票 ID，类型2或未关联时为 null"
                                    },
                                    "invoice_number": {
                                        "type": [
                                            "string",
