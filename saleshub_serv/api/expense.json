                                    },
                                    "order_no": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "description": "电商订单号，可能为 null"
                                    },
                                    "amount": {
                                        "type": "string",
                                        "description": "支出金额，数字字符串（如 478.00）"
                                    },
                                    "expense_date": {
                                        "type": "string",
                                        "description": "支出日期，YYYY-MM-DD HH24:MI:SS 格式字符串"
                                    },
                                    "category": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "description": "支出分类：1-办公资产费，2-差旅费，3-成本费，4-接待费，5-快递费，6-软件服务费，7-其他，可能为 null"
                                    },
                                    "payee": {
                                        "type": [
                                            "string",
