{
    "/saleshub/inventory/listProducts": {
        "method": "GET",
        "summary": "产品列表",
        "description": "分页查询当前正常状态（status=1）的产品。支持按名称 name 模糊匹配、编码 code 精确匹配筛选。按 create_time 降序。返回项不含状态与时间字段，仅含基础信息（含图片 ID）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "pageIndex": {
                    "type": "number",
                    "description": "页码，从 1 开始（Query 参数）"
                },
                "pageSize": {
                    "type": "number",
                    "description": "每页条数（Query 参数）"
                },
                "name": {
                    "type": "string",
                    "description": "产品名称，模糊匹配（Query 参数，可选）"
                },
                "code": {
                    "type": "string",
                    "description": "产品编码，精确匹配（Query 参数，可选）"
                }
            },
            "required": [
                "pageIndex",
                "pageSize"
            ]
        },
        "example_request": {
            "pageIndex": 1,
            "pageSize": 10,
            "name": "智能"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "分页结果",
                    "properties": {
                        "total": {
                            "type": "number",
                            "description": "符合条件的总条数"
                        },
                        "items": {
                            "type": "array",
                            "description": "产品列表",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "product_id": {
                                        "type": "string",
                                        "description": "产品主键 UUID（无连字符）"
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "产品名称"
                                    },
                                    "code": {
                                        "type": "string",
                                        "description": "产品编码，格式 PR + 6 位数字（如 PR000001）"
                                    },
                                    "description": {
                                        "type": "string",
                                        "description": "产品描述"
                                    },
                                    "image_id": {
                                        "type": "string",
                                        "description": "产品图片 ID（关联 file.relation_id），可能为 null"
                                    },
                                    "price": {
                                        "type": "number",
                                        "description": "产品价格，可能为 null"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "/saleshub/inventory/createProduct": {
        "method": "POST",
        "summary": "创建产品",
        "description": "创建产品记录。服务端自动生成编码 code（格式 PR + 6 位递增数字，如 PR000001；上限 999999），product_id 由 UUID v7 去连字符生成。code 在数据库层面具有唯一约束。status 默认 1。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "产品名称，最长 100 字符"
                },
                "description": {
                    "type": "string",
                    "description": "产品描述（可选，最长 500 字符）"
                },
                "image_id": {
                    "type": "string",
                    "description": "产品图片 ID（可选，关联 file.relation_id，最长 32 字符）"
                },
                "price": {
                    "type": "number",
                    "description": "产品价格（可选）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符）"
                }
            },
            "required": [
                "name"
            ]
        },
        "example_request": {
            "name": "智能终端 A1",
            "description": "面向零售场景的一体化智能终端设备",
            "image_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-创建失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "成功时返回新建产品 ID",
                    "properties": {
                        "product_id": {
                            "type": "string",
                            "description": "新建产品主键 UUID"
                        }
                    }
                }
            }
        }
    },
    "/saleshub/inventory/updateProduct": {
        "method": "POST",
        "summary": "更新产品",
        "description": "更新产品基础信息（名称、描述、图片）。仅当 product_id 对应的产品存在且 status=1 时可更新。name 为必填字段（直接覆盖原值）；description 传入时更新（支持传 null 清空）；image_id 传入时更新（支持传 null 清空图片）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID"
                },
                "name": {
                    "type": "string",
                    "description": "产品名称，最长 100 字符"
                },
                "description": {
                    "type": "string",
                    "description": "产品描述（可选，最长 500 字符；传入 null 可清空）"
                },
                "image_id": {
                    "type": "string",
                    "description": "产品图片 ID（可选，关联 file.relation_id；传入 null 可清空图片）"
                },
                "price": {
                    "type": "number",
                    "description": "产品价格（可选；传入 null 可清空价格）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符；传入 null 可清空）"
                }
            },
            "required": [
                "product_id",
                "name"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "name": "智能终端 A1（更新）",
            "description": "更新后的描述"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-产品不存在或更新失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                }
            }
        }
    },
    "/saleshub/inventory/deleteProduct": {
        "method": "POST",
        "summary": "删除产品",
        "description": "软删除产品（将 status 置为 2）。仅当 product_id 对应的产品存在时可操作。事务执行：同时将该产品及其所有有效关联记录（product_items.status=1）置为 status=2。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID"
                }
            },
            "required": [
                "product_id"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-产品不存在或删除失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                }
            }
        }
    },
    "/saleshub/inventory/setProductItems": {
        "method": "POST",
        "summary": "设置产品零件",
        "description": "全量覆盖语义：传入 product_id 与完整的 item 列表（含 spec_id），使该产品的有效关联（product_items.status=1 且 module_id 为空）等价于传入列表。事务执行：① 校验产品存在（status=1）；② 校验产品未使用模块方式管理零件（即产品下无活跃模块）；③ 校验列表中 (item_id, spec_id) 组合无重复；④ 校验所有 item_id 在 inventory_items 中存在且 status=1；⑤ 校验每条 spec_id 在 inventory_item_spec 中存在（status=1）且属于对应 item_id；⑥ 将该产品既有直接关联记录全部置为 status=2；⑦ 插入新的关联记录（module_id 为 null）。注意：产品只能选择「直接关联零件」或「通过模块管理零件」其中一种方式，若产品已有模块则无法使用此接口。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID"
                },
                "items": {
                    "type": "array",
                    "description": "零件关联列表（全量覆盖）",
                    "items": {
                        "type": "object",
                        "properties": {
                            "item_id": {
                                "type": "string",
                                "description": "零件主键 UUID"
                            },
                            "quantity_per_product": {
                                "type": "number",
                                "description": "单台产品所需数量（可选，最小 1，默认 1）"
                            },
                            "spec_id": {
                                "type": "string",
                                "description": "BOM 指定的零件规格 ID（inventory_item_spec.spec_id，来自零件列表接口 specs[].spec_id）"
                            },
                            "remark": {
                                "type": "string",
                                "description": "备注（可选，最长 500 字符）"
                            }
                        },
                        "required": [
                            "item_id",
                            "spec_id"
                        ]
                    }
                }
            },
            "required": [
                "product_id",
                "items"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "items": [
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abc",
                    "quantity_per_product": 2,
                    "spec_id": "0194b1d0e3f45a6b7890123456789def",
                    "remark": "主电源模块"
                },
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abc",
                    "spec_id": "0194b1d0e3f45a6b7890123456789deg",
                    "remark": "备用规格"
                },
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abd",
                    "spec_id": "0194b1d0e3f45a6b7890123456789deh",
                    "remark": "外壳"
                }
            ]
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-产品不存在/产品已使用模块方式/零件+规格重复/零件不存在或已停用/规格不存在或已停用/规格不属于该零件/设置失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息；零件不存在时返回「零件不存在或已停用: <缺失item_id列表>」；规格不存在时返回「规格不存在或已停用: <spec_id>」；规格归属错误时返回「规格 <spec_id> 不属于零件 <item_id>」；产品已有模块时返回「该产品已使用模块方式管理零件，无法直接关联零件」"
                }
            }
        }
    },
    "/saleshub/inventory/listProductItems": {
        "method": "GET",
        "summary": "产品零件列表",
        "description": "查询指定产品关联的零件列表。根据产品的零件管理方式返回不同结构：① 直接关联方式（use_module=false）：返回零件列表；② 模块方式（use_module=true）：返回模块列表，每个模块包含其下的零件列表。系统根据产品下是否存在活跃模块自动判断使用哪种方式。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID（Query 参数）"
                }
            },
            "required": [
                "product_id"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "产品零件列表结果",
                    "properties": {
                        "use_module": {
                            "type": "boolean",
                            "description": "是否使用模块方式管理零件：true-模块方式，返回 modules；false-直接关联方式，返回 items"
                        },
                        "items": {
                            "type": "array",
                            "description": "直接关联方式时的零件列表（use_module=false）；无关联时为空数组",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "relation_id": {
                                        "type": "string",
                                        "description": "关联记录主键 UUID（无连字符）"
                                    },
                                    "product_id": {
                                        "type": "string",
                                        "description": "所属产品 ID"
                                    },
                                    "module_id": {
                                        "type": "string",
                                        "description": "所属模块 ID（直接关联时为 null）"
                                    },
                                    "item_id": {
                                        "type": "string",
                                        "description": "零件 ID"
                                    },
                                    "quantity_per_product": {
                                        "type": "number",
                                        "description": "单台产品所需数量"
                                    },
                                    "spec_id": {
                                        "type": "string",
                                        "description": "BOM 指定的零件规格 ID（inventory_item_spec.spec_id）"
                                    },
                                    "spec": {
                                        "type": "string",
                                        "description": "规格名称（来自 inventory_item_spec.spec，便于展示）"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    },
                                    "item_name": {
                                        "type": "string",
                                        "description": "零件名称（来自 inventory_items.name）"
                                    },
                                    "item_code": {
                                        "type": "string",
                                        "description": "零件编码（来自 inventory_items.code）"
                                    },
                                    "type_id": {
                                        "type": "string",
                                        "description": "零件类型 ID（来自 inventory_items.type_id）"
                                    },
                                    "type_name": {
                                        "type": "string",
                                        "description": "零件类型名称（来自 item_type.type_name）"
                                    },
                                    "warn_stock": {
                                        "type": "number",
                                        "description": "零件预警阈值（来自 inventory_items.warn_stock）"
                                    },
                                    "current_stock": {
                                        "type": "number",
                                        "description": "该规格的当前库存（来自 inventory_item_spec.current_stock，按 spec_id 关联匹配；无匹配规格时为 null）"
                                    }
                                }
                            }
                        },
                        "modules": {
                            "type": "array",
                            "description": "模块方式时的模块列表（use_module=true）",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "module_id": {
                                        "type": "string",
                                        "description": "模块主键 UUID"
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "模块名称"
                                    },
                                    "code": {
                                        "type": "string",
                                        "description": "模块编码，可能为 null"
                                    },
                                    "sort_order": {
                                        "type": "number",
                                        "description": "排序号"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    },
                                    "items": {
                                        "type": "array",
                                        "description": "该模块下的零件列表",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "relation_id": {
                                                    "type": "string",
                                                    "description": "关联记录主键 UUID（无连字符）"
                                                },
                                                "product_id": {
                                                    "type": "string",
                                                    "description": "所属产品 ID"
                                                },
                                                "module_id": {
                                                    "type": "string",
                                                    "description": "所属模块 ID"
                                                },
                                                "item_id": {
                                                    "type": "string",
                                                    "description": "零件 ID"
                                                },
                                                "quantity_per_product": {
                                                    "type": "number",
                                                    "description": "单台产品所需数量"
                                                },
                                                "spec_id": {
                                                    "type": "string",
                                                    "description": "BOM 指定的零件规格 ID"
                                                },
                                                "spec": {
                                                    "type": "string",
                                                    "description": "规格名称"
                                                },
                                                "remark": {
                                                    "type": "string",
                                                    "description": "备注，可能为 null"
                                                },
                                                "item_name": {
                                                    "type": "string",
                                                    "description": "零件名称"
                                                },
                                                "item_code": {
                                                    "type": "string",
                                                    "description": "零件编码"
                                                },
                                                "type_id": {
                                                    "type": "string",
                                                    "description": "零件类型 ID"
                                                },
                                                "type_name": {
                                                    "type": "string",
                                                    "description": "零件类型名称"
                                                },
                                                "warn_stock": {
                                                    "type": "number",
                                                    "description": "零件预警阈值"
                                                },
                                                "current_stock": {
                                                    "type": "number",
                                                    "description": "该规格的当前库存，可能为 null"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "/saleshub/inventory/createModule": {
        "method": "POST",
        "summary": "创建模块",
        "description": "为产品创建模块。仅当产品存在（status=1）且未使用直接关联方式管理零件时（即产品下无直接关联的活跃零件）可创建。同一产品下模块名称不能重复。module_id 由 UUID v7 去连字符生成。status 默认 1。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID"
                },
                "name": {
                    "type": "string",
                    "description": "模块名称，最长 100 字符"
                },
                "sort_order": {
                    "type": "number",
                    "description": "排序号（可选，默认 0）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符）"
                }
            },
            "required": [
                "product_id",
                "name"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "name": "显示模块",
            "sort_order": 1,
            "remark": "包含屏幕及相关配件"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-产品不存在/产品已直接关联零件/模块名称已存在/创建失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "成功时返回新建模块 ID",
                    "properties": {
                        "module_id": {
                            "type": "string",
                            "description": "新建模块主键 UUID"
                        }
                    }
                }
            }
        }
    },
    "/saleshub/inventory/listModule": {
        "method": "GET",
        "summary": "模块列表",
        "description": "查询指定产品的模块列表（status=1）。按 sort_order 升序、create_time 升序排列。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "product_id": {
                    "type": "string",
                    "description": "产品主键 UUID（Query 参数）"
                }
            },
            "required": [
                "product_id"
            ]
        },
        "example_request": {
            "product_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "模块列表结果",
                    "properties": {
