                            "type": "array",
                            "description": "模块列表；无模块时为空数组",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "module_id": {
                                        "type": "string",
                                        "description": "模块主键 UUID"
                                    },
                                    "product_id": {
                                        "type": "string",
                                        "description": "所属产品 ID"
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "模块名称"
                                    },
                                    "sort_order": {
