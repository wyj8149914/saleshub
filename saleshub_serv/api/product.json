    "/saleshub/inventory/updateModule": {
        "method": "POST",
        "summary": "更新模块",
        "description": "更新模块基础信息（名称、编码、排序号、备注）。仅当 module_id 对应的模块存在且 status=1 时可更新。若修改名称，需校验同一产品下名称不重复。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "module_id": {
                    "type": "string",
                    "description": "模块主键 UUID"
                },
                "name": {
                    "type": "string",
                    "description": "模块名称（可选，最长 100 字符）"
                },
                "sort_order": {
                    "type": "number",
                    "description": "排序号（可选）"
                },
                "remark": {
                    "type": "string",
                    "description": "备注（可选，最长 500 字符；传入 null 可清空）"
                }
            },
            "required": [
                "module_id"
            ]
        },
        "example_request": {
            "module_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "name": "显示模块（更新）",
            "sort_order": 2
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-模块不存在/模块名称已存在/更新失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                }
            }
        }
    },
    "/saleshub/inventory/deleteModule": {
        "method": "POST",
        "summary": "删除模块",
        "description": "软删除模块（将 status 置为 2）。仅当模块下无活跃零件（product_items.status=1）时可删除。删除模块后，产品可切换为直接关联方式管理零件。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "module_id": {
                    "type": "string",
                    "description": "模块主键 UUID"
                }
            },
            "required": [
                "module_id"
            ]
        },
        "example_request": {
            "module_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-模块不存在/模块下存在零件/删除失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                }
            }
        }
    },
    "/saleshub/inventory/setModuleItems": {
        "method": "POST",
        "summary": "设置模块零件",
        "description": "全量覆盖语义：传入 module_id 与完整的 item 列表（含 spec_id），使该模块的有效关联（product_items.status=1）等价于传入列表。事务执行：① 校验模块存在（status=1）；② 校验列表中 (item_id, spec_id) 组合无重复；③ 校验所有 item_id 在 inventory_items 中存在且 status=1；④ 校验每条 spec_id 在 inventory_item_spec 中存在（status=1）且属于对应 item_id；⑤ 将该模块既有零件关联记录全部置为 status=2；⑥ 插入新的关联记录（关联到指定模块）。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "module_id": {
                    "type": "string",
                    "description": "模块主键 UUID"
                },
                "items": {
                    "type": "array",
                    "description": "零件关联列表（全量覆盖）",
                    "items": {
                        "type": "object",
                        "properties": {
                            "item_id": {
                                "type": "string",
                                "description": "零件主键 UUID"
                            },
                            "quantity_per_product": {
                                "type": "number",
                                "description": "单台产品所需数量（可选，最小 1，默认 1）"
                            },
                            "spec_id": {
                                "type": "string",
                                "description": "BOM 指定的零件规格 ID"
                            },
                            "remark": {
                                "type": "string",
                                "description": "备注（可选，最长 500 字符）"
                            }
                        },
                        "required": [
                            "item_id",
                            "spec_id"
                        ]
                    }
                }
            },
            "required": [
                "module_id",
                "items"
            ]
        },
        "example_request": {
            "module_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f",
            "items": [
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abc",
                    "quantity_per_product": 1,
                    "spec_id": "0194b1d0e3f45a6b7890123456789def",
                    "remark": "10寸显示屏"
                },
                {
                    "item_id": "0194b1c0a2d34e5f6789012345678abd",
                    "quantity_per_product": 4,
                    "spec_id": "0194b1d0e3f45a6b7890123456789deh",
                    "remark": "固定螺丝"
                }
            ]
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-模块不存在/零件+规格重复/零件不存在或已停用/规格不存在或已停用/规格不属于该零件/设置失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                }
            }
        }
    },
    "/saleshub/inventory/listModuleItems": {
        "method": "GET",
        "summary": "模块零件列表",
        "description": "查询指定模块关联的零件列表（product_items.status=1），并 innerJoin inventory_items 返回零件详情（名称、编码、类型、预警阈值），leftJoin inventory_item_spec（通过 spec_id）返回规格名称 spec 及该规格的当前库存 current_stock。按 product_items.create_time 降序。",
        "request_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "module_id": {
                    "type": "string",
                    "description": "模块主键 UUID（Query 参数）"
                }
            },
            "required": [
                "module_id"
            ]
        },
        "example_request": {
            "module_id": "0194a8f0e1b27c4a9d0e8f7b6c5d4e3f"
        },
        "response_body": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "type": "object",
            "properties": {
                "result": {
                    "type": "number",
                    "description": "结果码：0-成功，1-模块不存在/查询失败"
                },
                "msg": {
                    "type": "string",
                    "description": "提示信息"
                },
                "datas": {
                    "type": "object",
                    "description": "模块零件列表结果",
                    "properties": {
                        "items": {
                            "type": "array",
                            "description": "关联记录列表；无关联时为空数组",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "relation_id": {
                                        "type": "string",
                                        "description": "关联记录主键 UUID（无连字符）"
                                    },
                                    "product_id": {
                                        "type": "string",
                                        "description": "所属产品 ID"
                                    },
                                    "module_id": {
                                        "type": "string",
                                        "description": "所属模块 ID"
                                    },
                                    "item_id": {
                                        "type": "string",
                                        "description": "零件 ID"
                                    },
                                    "quantity_per_product": {
                                        "type": "number",
                                        "description": "单台产品所需数量"
                                    },
                                    "spec_id": {
                                        "type": "string",
                                        "description": "BOM 指定的零件规格 ID"
                                    },
                                    "spec": {
                                        "type": "string",
                                        "description": "规格名称（来自 inventory_item_spec.spec）"
                                    },
                                    "remark": {
                                        "type": "string",
                                        "description": "备注，可能为 null"
                                    },
                                    "item_name": {
                                        "type": "string",
                                        "description": "零件名称（来自 inventory_items.name）"
                                    },
                                    "item_code": {
                                        "type": "string",
                                        "description": "零件编码（来自 inventory_items.code）"
                                    },
                                    "type_id": {
                                        "type": "string",
                                        "description": "零件类型 ID（来自 inventory_items.type_id）"
                                    },
                                    "type_name": {
                                        "type": "string",
                                        "description": "零件类型名称（来自 item_type.type_name）"
                                    },
                                    "warn_stock": {
                                        "type": "number",
                                        "description": "零件预警阈值（来自 inventory_items.warn_stock）"
                                    },
                                    "current_stock": {
                                        "type": "number",
                                        "description": "该规格的当前库存（来自 inventory_item_spec.current_stock；无匹配规格时为 null）"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}