{
    "compilerOptions": {
        "target": "ES2020", // 指定编译输出的 JS 语法标准。TS 会将新语法降级至 ES2020
        "module": "Node16", // Node.js 16+ 模块系统（与 moduleResolution 配对；无 "type":"module" 时仍输出 CommonJS）
        "lib": [
            "ES2020"
        ], // 指定编译时包含的内置类型库（如 Array.prototype.flat、Promise 等）
        "outDir": "./dist", // 指定编译后输出文件的目录
        "rootDir": "./src", // 指定源文件的根目录
        "strict": true, // 启用所有严格的类型检查选项
        "esModuleInterop": true, // 允许从 CommonJS 模块中更自然地导入 ES 模块。解决 import * as foo from 'foo' 与 import foo from 'foo' 的兼容问题
        "skipLibCheck": true, // 跳过对 .d.ts 类型声明文件的类型检查
        "forceConsistentCasingInFileNames": true, // 强制要求文件名大小写一致
        "resolveJsonModule": true, // 允许直接导入 .json 文件
        "moduleResolution": "Node16", // 模块解析策略。按 Node.js 16+ 规则查找 node_modules（替代已弃用的 node/node10）
        "allowSyntheticDefaultImports": true, // 允许无默认导出的模块使用 import x from 'y'（仅类型检查）
        "emitDecoratorMetadata": true, // 为装饰器（如 NestJS、TypeORM 中的 @Entity()）生成元数据
        "experimentalDecorators": true,
        "strictPropertyInitialization": false, // 关闭类属性必须在构造函数中初始化的检查
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}