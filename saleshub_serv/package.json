{
    "name": "card-backend-node",
    "version": "1.0.0",
    "description": "库存销售管理统 - Node.js后端服务",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start:dev": "cross-env NODE_ENV=development node dist/server.js",
        "start:pro": "cross-env NODE_ENV=production node dist/server.js",
        "dev": "cross-env NODE_ENV=development ts-node src/server.ts",
        "pro": "cross-env NODE_ENV=production ts-node src/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "merge-items": "cross-env NODE_ENV=development ts-node scripts/merge-items.ts"
    },
    "keywords": [
        "card",
        "business-card",
        "express",
        "typescript",
        "typeorm"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.7.3",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "cross-env": "^10.1.0",
        "dayjs": "^1.11.20",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^6.7.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "log4js": "^6.9.1",
        "minio": "^8.0.7",
        "multer": "^2.1.1",
        "p-limit": "^7.3.3",
        "pg": "^8.12.0",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.7.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.3",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/multer": "^1.4.7",
        "@types/node": "^20.4.2",
        "@types/supertest": "^2.0.12",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jest": "^29.6.1",
        "prettier": "^3.0.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.6"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    }
}
